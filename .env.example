LOG_LEVEL=INFO
DEEPSEEK_WEB_SEARCH=enabled
DEEPSEEK_SAFETY_LEVEL=high
MEMORY_DB_PATH=data/memory.sqlite
DISCORD_DIGEST_CHANNEL_ID=
DIGEST_ENABLED=enabled
DIGEST_INTERVAL_HOURS=24
DIGEST_INITIAL_DELAY_SECONDS=60
DIGEST_DB_PATH=data/digest.sqlite
